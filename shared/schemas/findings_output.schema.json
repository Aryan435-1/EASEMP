{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARGUS Findings Output",
  "description": "Output contract from Member 2 (Risk Engine) to Member 3 (Security Platform)",
  "type": "object",
  "required": ["asset", "port", "product", "version", "findings"],
  "properties": {
    "asset": { "type": "string" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "product": { "type": "string" },
    "version": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cve_id", "cvss_score", "severity", "risk_score", "priority"],
        "properties": {
          "cve_id": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
          "cvss_score": { "type": "number", "minimum": 0, "maximum": 10 },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "known_exploited": { "type": "boolean" },
          "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "priority": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}